@model IEnumerable<LGYTech_demo.Models.Products>

@{
    ViewBag.Title = "Item List";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string search = ViewBag.Search as string;
}

<h2>Item List</h2>
<form method="get" action="@Url.Action("Index", "Products")">
    <div class="form-group">
        <label for="search">Search Item</label>

        <input type="text"
               id="search"
               name="search"
               value="@search"
               class="form-control"
               placeholder="Search Item Name..." />
    </div>

    <button type="submit" class="btn btn-primary">
        Ara
    </button>

    <a href="@Url.Action("Index", "Products")"
       class="btn btn-default">
        Clear
    </a>
</form>
<hr />

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Item Name</th>
            <th>SKU</th>
            <th>Price</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Sku</td>
                <td>@product.Price.ToString("N2") TL</td>
                <td>@product.Stock</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>We dont have you Item looking for.</p>
}

@if (totalPages > 1)
{
    <nav aria-label="Item pages">
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="@(i == currentPage ? "active" : "")">
                    <a href="@Url.Action("Index", "Products",
                        new { search = search, page = i })">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}