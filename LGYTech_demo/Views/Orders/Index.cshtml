@model IEnumerable<LGYTech_demo.Models.Order>
@using System.Linq

@{
    ViewBag.Title = "Order History";
}

<h2>Order History</h2>

<p>
    @Html.ActionLink(
        "Create New Order",
        "Create",
        "Orders",
        null,
        new { @class = "btn btn-primary" }
    )
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No orders have been created yet.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer Name</th>
                <th>Created At</th>
                <th>Products</th>
                <th>Total Amount</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>

                    <td>@order.CustomerName</td>

                    <td>
                        @order.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        <small>(UTC)</small>
                    </td>

                    <td>
                        @foreach (var line in order.OrderLines)
                        {
                            <div>
                                <strong>@line.Quantity ×</strong>

                                @line.Product.Name

                                <span class="text-muted">
                                    (@line.UnitPrice.ToString("N2") TL / unit)
                                </span>
                            </div>
                        }
                    </td>

                    <td>
                        <strong>
                            @order.Total.ToString("N2") TL
                        </strong>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}