<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - LGYTech Demo</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet"
          href="@Url.Content("~/Content/bootstrap.min.css")" />

    <!-- Application styles -->
    <link rel="stylesheet"
          href="@Url.Content("~/Content/Site.css")" />
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            @Html.ActionLink(
                "LGYTech",
                "Index",
                "Products",
                null,
                new { @class = "navbar-brand" }
            )

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        @Html.ActionLink("Items", "Index", "Products",
                            null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("New Item", "Create", "Products",
                            null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Orders", "Index", "Orders",
                            null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Create Order", "Create", "Orders",
                            null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                            "Stock Movements",
                            "Index",
                            "StockMovements",
                            null,
                            new { @class = "nav-link" }
                        )
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- Main page content -->
    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="container border-top py-3">
        <p class="text-muted">
            &copy; @DateTime.Now.Year - LGYTech Demo
        </p>
    </footer>

    <!-- jQuery -->
    @Scripts.Render("~/bundles/jquery")

    <!-- Bootstrap 5 JavaScript -->
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>

    <!-- Page-specific scripts -->
    @RenderSection("scripts", required: false)
</body>
</html>